# Local generator settings. Copy to ./config and edit there.
# Topics are data: add, remove, reorder, or edit id/label/prompt entries.
# Keep IDs unique and save selected_topic_id to choose one topic.

[news]
selected_topic_id = "ai_news"
retry_count = 2
interval_seconds = 0
deadline_seconds = 0
attempt_timeout_seconds = 180

[[news.topics]]
id = "ai_news"
label = "最新AIニュース"
prompt = "24時間以内に発表された、注目に値する面白いAIニュースを1件選び、何が起きたかを要約してください。"

[[news.topics]]
id = "inventions"
label = "世界の珍発明"
prompt = "世界の珍発明や研究装置から発想または用途が意外なものを1件選び、目的、仕組み、確認された効果を要約してください。"

[[news.topics]]
id = "science"
label = "科学の意外な発見"
prompt = "動物、人体、自然、深海、宇宙の意外な科学的発見を1件選び、何がわかり、従来の理解とどう違うかを要約してください。"

[[news.topics]]
id = "culture"
label = "世界の変わった文化・珍風習"
prompt = "世界の変わった文化や珍風習から祭り、大会、習慣、地域の取り決めを1件選び、背景と当事者にとっての意味を要約してください。文化を嘲笑しないでください。"

[[news.topics]]
id = "tech_reality"
label = "技術の大風呂敷と現実"
prompt = "技術の理想や大きな宣伝と、実際の性能または利用法にギャップがある例を1件選び、両方を出典で確認して要約してください。推測だけで失敗と決めつけないでください。"

[[news.topics]]
id = "maker"
label = "個人開発者のすごい工作"
prompt = "個人開発者の電子工作、ラズパイ、マイコン、3Dプリンタ、レトロPCの作品を1件選び、できることと工夫を要約してください。制作者の一次発信を優先してください。"

[[news.topics]]
id = "future_past"
label = "昔の未来予想と今"
prompt = "過去に語られた未来予想を1件選び、予測された時期と元の内容を確認した上で、現在の実際の状況と比較して要約してください。"

[[news.topics]]
id = "curiosity"
label = "役に立たないけれど面白い事実"
prompt = "生物、身近な物、技術史から役には立たないけれど面白い意外な事実を1件選び、俗説を避けて信頼できる公開出典に基づき要約してください。"

[[news.topics]]
id = "lifehack"
label = "ひと目でわかるライフハック"
prompt = "日常、整理、収納、道具、簡単工作から、250×122の白黒一枚絵と短い説明で工夫と効果が伝わるライフハックを1件選んでください。危険な改造や細かい分量・注意が不可欠な題材は避けてください。"

[[news.topics]]
id = "quirky_news"
label = "世界・国内のクスッと笑えるB級ニュース"
prompt = "24時間以内に世界か日本で話題になったクスッと笑えるB級ニュースを1件選んでください。微笑ましい行動、偶然、勘違い、予想外の展開を優先し、被害や個人への嘲笑を笑いの中心にしないでください。"

[[news.topics]]
id = "travel"
label = "世界の訪れるべき観光地・絶景地"
prompt = "世界の訪れるべき観光地や絶景地から、景観や体験に魅力のある場所を1つ選び、名称、所在地、何が特別かを出典付きで要約してください。公式観光案内など現地情報を優先してください。"

[image]
retry_count = 2
interval_seconds = 0
deadline_seconds = 0
attempt_timeout_seconds = 300
